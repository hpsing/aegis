# /etc/aegis/aegis.env — installed by deploy/install-remote.sh
#
# Copy this file to /etc/aegis/aegis.env on the server and fill in
# every PRIVATE KEY / API KEY value. Restart the units after editing:
#   sudo systemctl restart aegis.target

# ---------- chain endpoints ----------
RPC_URL=https://evmrpc-testnet.0g.ai
SWAP_RPC=https://evmrpc-testnet.0g.ai

# ---------- contracts (Galileo testnet defaults) ----------
AEGIS_ADDR=0xa89833fBD1844763cc77C0a3aFaE32697A2F990f
USDC_ADDR=0xe9dA98EB0AF68cC48be7F71C29A7Bc5bA7fB45Eb
REGISTRY_ADDR=0x50ce23AE35bbe43fFAd0B36FD3F567560b8EfB18

# ---------- wallets (REQUIRED — no defaults) ----------
TREASURY_PK=0x...
EXECUTOR_PK=0x...
V1_PK=0x...
V2_PK=0x...
V3_PK=0x...

# ---------- KeeperHub ----------
ORG1_API_KEY=
ORG2_API_KEY=
ORG3_API_KEY=

# ---------- UI server ----------
UI_ADDR=:3000
UI_LOGS_DIR=/var/log/aegis
UI_AXL_DAEMONS=pub=http://127.0.0.1:9002,v1=http://127.0.0.1:9012,v2=http://127.0.0.1:9022,v3=http://127.0.0.1:9032

# ---------- access control (POST endpoints) ----------
# Comma-separated checksummed addresses allowed to POST /api/post-job.
# Leave empty to disable the gate (NOT recommended on a public box —
# anyone can drain TREASURY_PK by spamming jobs).
AEGIS_WHITELIST=
